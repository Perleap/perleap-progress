# Copy to .env.verify and fill in (never commit .env.verify)
# Uses the same Supabase project as .env / .env.local

VERIFY_PORT=8081
VERIFY_BASE_URL=http://127.0.0.1:8081

VERIFY_STUDENT_EMAIL=
VERIFY_STUDENT_PASSWORD=
VERIFY_TEACHER_EMAIL=
VERIFY_TEACHER_PASSWORD=

# Optional: app-admin account (falls back to teacher creds if unset)
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=

# Optional: for student-join-class feature proof
VERIFY_INVITE_CODE=

# Optional: deep-link when teacher dashboard has no classroom cards
VERIFY_TEACHER_CLASSROOM_ID=

# auto = try password, then magic link (for Google accounts). Requires VITE_SUPABASE_SECRET_KEY in .env.local
VERIFY_AUTH_MODE=auto

# Watch live: 1 = visible browser, slow-mo ms between actions, 1 = leave browser open after run
VERIFY_HEADED=0
VERIFY_SLOW_MO=0
VERIFY_KEEP_OPEN=0

