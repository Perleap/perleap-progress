# Copy to .env.verify.staging and fill in (never commit .env.verify.staging)
# Uses the same Supabase project as .env / .env.local

VERIFY_PROFILE=staging
VERIFY_BASE_URL=https://staging.perleap.ai
VERIFY_PORT=443

VERIFY_STUDENT_EMAIL=
VERIFY_STUDENT_PASSWORD=
VERIFY_TEACHER_EMAIL=
VERIFY_TEACHER_PASSWORD=

# Optional: app-admin account (falls back to teacher creds if unset)
VERIFY_ADMIN_EMAIL=
VERIFY_ADMIN_PASSWORD=

VERIFY_AUTH_MODE=auto

# Optional: Vercel Deployment Protection (pick one)
# VERCEL_AUTOMATION_BYPASS_SECRET=   # from Vercel → Settings → Deployment Protection
# VERCEL_OIDC_TOKEN=                 # from `vercel login` then `vercel env pull .env.local`
# VERCEL_SHARE_TOKEN=                # from Vercel MCP get_access_to_vercel_url (expires ~23h)

# Watch live during loop runs
VERIFY_HEADED=0
VERIFY_SLOW_MO=0
VERIFY_KEEP_OPEN=0
